`</field><data>{"commentRefs":[],"fieldData":{"img":null}}</data></shadow></value><next><block type="scroller_scrollBackgroundWithSpeed" id="H#N+_0hU=+(J1^=K{fGM"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><value name="vx"><shadow type="math_number" id="L6Vi8#ed{Wv!.xb9Q{7x"><field name="NUM">0</field></shadow></value><value name="vy"><shadow type="math_number" id="j)Qh`au$W%2rlf?xky#9"><field name="NUM">20</field></shadow></value><next><block type="spritesetpos" id="{Vx.0dWR:s(Uf2?Ph$+j"><value name="sprite"><block type="variables_get" id="w5Ld}2Lhl#946?G1?|nQ"><field name="VAR" id="8(^Psn`zg[5va8+Q_-9Q">Box</field></block></value><value name="x"><shadow type="positionPicker" id="V2?UtuF[8Ts7B(#rbSu{"><field name="index">92</field></shadow></value><value name="y"><shadow type="positionPicker" id="YR)iH(x2U#{zeRj.ceNq"><field name="index">95</field></shadow></value><next><block type="variables_set" id="8i[N2^Yc_`}Rlq*FU:G-"><field name="VAR" id="d#id2WFJaVv42m;uD*1*">index</field><value name="VALUE"><shadow type="math_number" id="*!M6Nz!kg!3EY]gkmNy1"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="L0WY,KA-b_M-q@.P{8IL"><field name="VAR" id="*mE)Yl`vO~%R+FWVN~Mb">text_list</field><value name="VALUE"><shadow type="math_number" id="6K=3S0T|~rJ8{Nspqr_M"><field name="NUM">0</field></shadow><block type="lists_create_with" id="T5s4}#~%YbQ{o]8}^.3N" inline="false"><mutation items="26" horizontalafter="3"></mutation><value name="ADD0"><shadow type="text" id="5}hQnCg^u$XtVE#qSFwG"><field name="TEXT">You know how to hack, right?</field></shadow></value><value name="ADD1"><shadow type="text" id="7@a`C_Q5k/gSj;},$Cb9"><field name="TEXT">It is you, after all...</field></shadow></value><value name="ADD2"><shadow type="text" id="WlVSc(jvhA_b./vSV.mk"><field name="TEXT">who's cracking open the safe.</field></shadow></value><value name="ADD3"><shadow type="text" id="|L2xjHJqmc#pf3W=ZGWL"><field name="TEXT">If you must be reminded,</field></shadow></value><value name="ADD4"><shadow type="text" id="GiDoqh!TA79}e_vCV1?:"><field name="TEXT">then here's what you need to know.</field></shadow></value><value name="ADD5"><shadow type="text" id="QHV0N@Z^)jAf_,Z2aL#7"><field name="TEXT">There are three sections.</field></shadow></value><value name="ADD6"><shadow type="text" id="`a-JF;G3mtlGL1Ev]s+6"><field name="TEXT">Press "B" to move between them.</field></shadow></value><value name="ADD7"><shadow type="text" id="waXA74Y_Yrn*8z+U/{ut"><field name="TEXT">Section One, you are a green dot.</field></shadow></value><value name="ADD8"><shadow type="text" id="Zi?7Vu|;`1_z1JytQBJ3"><field name="TEXT">Use WASD to move.</field></shadow></value><value name="ADD9"><shadow type="text" id="@/Xg8CO?1zq`=F}8;L%e"><field name="TEXT">Avoid the green barrier.</field></shadow></value><value name="ADD10"><shadow type="text" id="kIkuV_U#uL53_^@7s:1f"><field name="TEXT">Collect all the red dots.</field></shadow></value><value name="ADD11"><shadow type="text" id="Itafc*BrX7s~/}94,dN}"><field name="TEXT">Section Two, you are a purple dot.</field></shadow></value><value name="ADD12"><shadow type="text" id="xYfFf(KFs(ldj7%mFpNr"><field name="TEXT">Use A and D to move left and right.</field></shadow></value><value name="ADD13"><shadow type="text" id="!JA.$=Rfq1mqOG!s?k3:"><field name="TEXT">Press "A" to jump.</field></shadow></value><value name="ADD14"><shadow type="text" id="%(piZO=Om}n?KO?,qPJa"><field name="TEXT">Click "A" a lot on a wall to climb.</field></shadow></value><value name="ADD15"><shadow type="text" id="_KXW*V2=m#:#!z/!cdLC"><field name="TEXT">There are gates blocking your path-</field></shadow></value><value name="ADD16"><shadow type="text" id="oXP/!d9s}#iI1WrpMPG|"><field name="TEXT">Collect keys to unlock them.</field></shadow></value><value name="ADD17"><shadow type="text" id="x_.qj+?Pr8Nw%Y+n$IAJ"><field name="TEXT">This also applies to Section One.</field></shadow></value><value name="ADD18"><shadow type="text" id="K^Ki($-X`%~I+vQ[]^I!"><field name="TEXT">Section Three, you are a blue dot.</field></shadow></value><value name="ADD19"><shadow type="text" id="wBS;*p^*fGc#a2+D_8DV"><field name="TEXT">Use WASD to move.</field></shadow></value><value name="ADD20"><shadow type="text" id="VZe}pzz,qYH62`i3W8M/"><field name="TEXT">Avoid the red sensors.</field></shadow></value><value name="ADD21"><shadow type="text" id="4EyRxk1%O-loZf1:IyTN"><field name="TEXT">If you touch them...</field></shadow></value><value name="ADD22"><shadow type="text" id="9H5Bg4p^sDFcKM$DJMm,"><field name="TEXT">The mission will be compromised.</field></shadow></value><value name="ADD23"><shadow type="text" id="0J6nBJi9cQ}$OSM+lPxC"><field name="TEXT">You have five minutes to break in.</field></shadow></value><value name="ADD24"><shadow type="text" id=",~C{C6qJ%{B;P6DZBwBg"><field name="TEXT">Failure to do so will get us caught.</field></shadow></value><value name="ADD25"><shadow type="text" id="!}5]|dtg[(G[f-Wyu.l)"><field name="TEXT">Don't let us down.</field></shadow></value></block></value><next><block type="timer_after" id="XI*b,aSsEbWLFiN=R=8B"><value name="time"><shadow type="math_number" id="#NwmE{s0F;55F!kLpA7y"><field name="NUM">200</field></shadow></value><statement name="HANDLER"><block type="music_playable_play" id="t+KUF|?oWO$=Ed%9[r2c"><field name="playbackMode">music.PlaybackMode.LoopingInBackground</field><value name="toPlay"><shadow type="music_song_field_editor" id="N?61+43FlGX@}+BtG:yO"><field name="song">hex``</field><data>{"commentRefs":[],"fieldData":{"song":null}}</data></shadow></value><next><block type="spritesetimage" id="kJY_,fwIcT]I(vGWm_N;"><value name="sprite"><block type="variables_get" id="^5)!JW#9O=nTKR[QD(0)"><field name="VAR" id="8(^Psn`zg[5va8+Q_-9Q">Box</field></block></value><value name="img"><shadow type="screen_image_picker" id=":)*~:ZY5tqkX2JlHtDpC"><field name="img">img`
