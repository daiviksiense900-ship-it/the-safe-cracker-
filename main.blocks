`</field><data>{"commentRefs":[],"fieldData":{"img":null}}</data></block></value><next><block type="variables_set" id="1Kc.@0C)gyY$!aSi(#|O"><field name="VAR" id="$/C.@wpXQ8FA=SxD`ulr">dead</field><value name="VALUE"><shadow type="math_number" id="tE=RD.NI^5vQTkOD_(i|"><field name="NUM">0</field></shadow><block type="logic_boolean" id="=v}FM^3Z($bkc12Y3{.T"><field name="BOOL">TRUE</field></block></value><next><block type="variables_set" id="zZ,BA,ww.@!Sp0NW[(ie"><field name="VAR" id="*mE)Yl`vO~%R+FWVN~Mb">text_list</field><value name="VALUE"><block type="lists_create_with" id="*6JGG42aWyO%Dyw!nv8-" inline="false"><mutation items="25" horizontalafter="3"></mutation><value name="ADD0"><shadow type="text" id="eF5oln*o4V1*_)iLrPw,"><field name="TEXT">You've cracked open the safe!</field></shadow></value><value name="ADD1"><shadow type="text" id="x`ET/Z~E9@_Q-)[yUm:Y"><field name="TEXT">And now...</field></shadow></value><value name="ADD2"><shadow type="text" id="1^vH{3@=MtPq^+My*H{5"><field name="TEXT">we need you to do something else.</field></shadow></value><value name="ADD3"><shadow type="text" id="r+bYX,/QXCagvyZQUoF["><field name="TEXT">Steve is heading to the safe now-</field></shadow></value><value name="ADD4"><shadow type="text" id="_X(s+h9;]TkOZHYXtpS|"><field name="TEXT">but the cameras are still active.</field></shadow></value><value name="ADD5"><shadow type="text" id="r7cJQbg!0i~^d#p~o]w_"><field name="TEXT">We need you to shut them off...</field></shadow></value><value name="ADD6"><shadow type="text" id="{6);Wh~URFP.8NU(fJV]"><field name="TEXT">but at the right time.</field></shadow></value><value name="ADD7"><shadow type="text" id="zNEU^`lI=W`d`E,YK@Sa"><field name="TEXT">Security cams have backup systems,</field></shadow></value><value name="ADD8"><shadow type="text" id=")}@u2k3u+-YT9PKwP}Md"><field name="TEXT">so if you shut the power off,</field></shadow></value><value name="ADD9"><shadow type="text" id="3QHB4Vpnapt/n$li8N0q"><field name="TEXT">they will turn back on in 9 seconds.</field></shadow></value><value name="ADD10"><shadow type="text" id="qN-;%Wh+$T4ut!}5;Dcl"><field name="TEXT">After that,</field></shadow></value><value name="ADD11"><shadow type="text" id="m?tb{cQwz[j6xFyY7C`O"><field name="TEXT">It's impossible to shut it off.</field></shadow></value><value name="ADD12"><shadow type="text" id="{7y#JQ!uhdJFUd+?{C,H"><field name="TEXT">Steve has his radio broken,</field></shadow></value><value name="ADD13"><shadow type="text" id="2EQW!!kv2f6n%cLgCHFv"><field name="TEXT">so we can't communicate the timing.</field></shadow></value><value name="ADD14"><shadow type="text" id="+jZ-9a~DHU9=%fzh1*+["><field name="TEXT">Thankfully he only needs 7 seconds.</field></shadow></value><value name="ADD15"><shadow type="text" id="zAM!`IXUXK~r?-NnVD=|"><field name="TEXT">To get the money, and to get out.</field></shadow></value><value name="ADD16"><shadow type="text" id=".]pjlN#PR*{OjzS,)%t#"><field name="TEXT">So, when you hear him coming,</field></shadow></value><value name="ADD17"><shadow type="text" id="sD~D+8j?}2~=5Ot*DQ4b"><field name="TEXT">make sure to turn off the cams.</field></shadow></value><value name="ADD18"><shadow type="text" id="hQZsy9-}Bv3S;bSx7Vj/"><field name="TEXT">Don't do it immediately, though.</field></shadow></value><value name="ADD19"><shadow type="text" id="g_j_msV/#z:PXr:=~t{:"><field name="TEXT">If you do, the cams will come back,</field></shadow></value><value name="ADD20"><shadow type="text" id="k9/z,YR33*iFD%Kok8;v"><field name="TEXT">catching Steve in the act.</field></shadow></value><value name="ADD21"><shadow type="text" id="RsuK5g/yyV-0b.E?KJAV"><field name="TEXT">Don't let us down.</field></shadow></value><value name="ADD22"><shadow type="text" id="NoRX|`Bmb@~BhyeGzah."><field name="TEXT">And make sure not to confuse noises,</field></shadow></value><value name="ADD23"><shadow type="text" id="}{ea}/.bJmyKzlqjOgNh"><field name="TEXT">not every noise is footsteps.</field></shadow></value><value name="ADD24"><shadow type="text" id="IS50H}1^V67*:hrPaQ{^"><field name="TEXT">a</field></shadow></value></block></value><next><block type="variables_set" id="{)Y{pO_[:n*3U,L6KKE;"><field name="VAR" id="d#id2WFJaVv42m;uD*1*">index</field><value name="VALUE"><shadow type="math_number" id="sd;d}*e{E*F%*S+JL7h$"><field name="NUM">0</field></shadow></value><next><block type="variables_set" id="S{#yb=z8.-_(!xMd=`0|"><field name="VAR" id="8(^Psn`zg[5va8+Q_-9Q">Box</field><value name="VALUE"><shadow type="math_number" id=";1GDzaT~yb2pz{6uFvS?"><field name="NUM">0</field></shadow><block type="spritescreate" id="edSxi25m*AQ!3eqY5@K3"><value name="img"><shadow type="screen_image_picker" id="hR3_l{Av1cppt3[L%^YY"><field name="img">img`
